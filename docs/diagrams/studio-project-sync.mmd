sequenceDiagram
    actor Operator
    participant Studio
    participant Git as "Git repository"
    participant CLI as "liapoldus CLI"
    participant Core as "Core API"
    Operator->>Studio: "Open project"
    Studio->>Git: "Index and validate"
    Operator->>Studio: "Edit draft"
    Studio->>Git: "Save source and create commit"
    Operator->>CLI: "Plan/apply commit for target"
    CLI->>Git: "Read immutable revision"
    CLI->>Core: "Submit canonical bundle"
    Core-->>CLI: "operationId and generation"
    CLI-->>Studio: "Import deploy report"
