{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "name": "Liapoldus Design System",
  "version": "1.0.0",
  "color": {
    "canvas": { "$value": "#F7F7F7", "$type": "color" },
    "surface": { "$value": "#FFFFFF", "$type": "color" },
    "surfaceSubtle": { "$value": "#F2F2F2", "$type": "color" },
    "surfaceMuted": { "$value": "#E8E8E8", "$type": "color" },
    "ink": { "$value": "#111111", "$type": "color" },
    "textSecondary": { "$value": "#444444", "$type": "color" },
    "textMuted": { "$value": "#737373", "$type": "color" },
    "border": { "$value": "#DEDEDE", "$type": "color" },
    "borderStrong": { "$value": "#A4A4A4", "$type": "color" }
  },
  "spacing": {
    "1": { "$value": "4px", "$type": "dimension" },
    "2": { "$value": "8px", "$type": "dimension" },
    "3": { "$value": "12px", "$type": "dimension" },
    "4": { "$value": "16px", "$type": "dimension" },
    "6": { "$value": "24px", "$type": "dimension" },
    "8": { "$value": "32px", "$type": "dimension" }
  },
  "radius": {
    "small": { "$value": "6px", "$type": "dimension" },
    "medium": { "$value": "10px", "$type": "dimension" },
    "large": { "$value": "16px", "$type": "dimension" }
  },
  "typography": {
    "sans": { "$value": "Inter, system-ui, sans-serif", "$type": "fontFamily" },
    "mono": { "$value": "SFMono-Regular, Consolas, monospace", "$type": "fontFamily" }
  }
}
