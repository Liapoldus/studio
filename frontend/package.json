{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "bindings:prepare": "tsx ../scripts/bindings/prepare.mts",
    "bindings:check": "tsx ../scripts/bindings/check.mts",
    "desktop:build": "tsx ../scripts/desktop/build.mts",
    "test": "tsx --test ../tests/**/*.test.mts",
    "lint": "cd .. && frontend/node_modules/.bin/eslint --config frontend/eslint.config.mjs \"frontend/**/*.ts\" \"frontend/**/*.tsx\" \"frontend/*.mjs\" \"scripts/**/*.{ts,mts}\" \"tests/**/*.{ts,mts}\" --max-warnings 0",
    "dev": "vite",
    "build": "tsc && vite build",
    "build:web": "tsc && vite build --config vite.web.config.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/babel__core": "7.20.5",
    "@types/node": "22.20.5",
    "@types/react": "^18.0.17",
    "@types/react-dom": "^18.0.6",
    "@vitejs/plugin-react": "5.2.0",
    "eslint": "9.39.5",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vite": "7.3.7"
  }
}
